
% !TeX root = ../../Thermod.tex


\begin{tikzpicture}[midarr/.style={decoration={markings,mark=at position #1 with
  {\arrow{stealth}}},postaction={decorate}},
  midarr/.default=0.5]

  \def\xmax{8}
  \def\ymax{8}
  % AXIS
%  \draw[gray!50] (0,0) grid (\xmax, \ymax);
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax)
    node[anchor=north east,inner sep=4,scale=1] {$T$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north east,inner sep=4,scale=1] {$S$};

\coordinate (1) at (4, 7);
\coordinate (2) at (7, 7);
\coordinate (3) at (4, 2);
\coordinate (4) at (1, 2);

\fill[plotlightblue] (1) -- (2) to[bend left=25] (3) -- (4) to[bend right=25] (1);

\draw[plotblue, midarr, ultra thick] (1) -- (2);
\draw[plotblue, midarr, ultra thick] (2) to[bend left=25] (3) ;
\draw[plotblue, midarr, ultra thick] (3) -- (4);
\draw[plotblue, midarr, ultra thick] (4) to[bend right=25] (1);

\draw[dashed, plotred, thick] (4) -- ++(0, 5) -- (1) -- (3) -- cycle;




  \path[]
     (1) node[circle, fill, inner sep=1.5pt] {} node[above] {$1$}
     (2) node[circle, fill, inner sep=1.5pt] {} node[above]  {$2$}
     (3) node[circle, fill, inner sep=1.5pt] {} node[below]  {$3$}
     (4) node[circle, fill, inner sep=1.5pt] {} node[below] {$4$};



\end{tikzpicture}