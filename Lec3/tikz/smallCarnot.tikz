  % AXIS
%  \draw[gray!50] (0,0) grid (\xmax, \ymax);
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax)
    node[anchor=north east,inner sep=4,scale=1] {$P$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north east,inner sep=4,scale=1] {$V$};


\coordinate (1) at (2, 6);
\coordinate (2) at (6, 5);
\coordinate (3) at (7, 1);
\coordinate (4) at (3, 2);


\draw[ultra thick, plotblue, fill=plotlightblue] (1) -- (2) -- (3) -- (4) -- cycle;

\draw[gray, name path=4] let \p1=(3), \p2=(4) in (4) -- ++({atan((\y2-\y1)/(\x2-\x1))}:-2);
\draw[gray] let \p1=(3), \p2=(4) in (3) -- ++({atan((\y2-\y1)/(\x2-\x1))}:1)  node[right, text=black]
{$T - \Delta
T$};

\draw[gray] let \p1=(2), \p2=(1) in (1) -- ++({atan((\y2-\y1)/(\x2-\x1))}:-1);
\draw[gray] let \p1=(2), \p2=(1) in (2) -- ++({atan((\y2-\y1)/(\x2-\x1))}:1) node[right, text=black]
{$T$};

\path[name path=1] (1) -- ++(0, -6);
\draw[line width=1, >={LaTeX[width=5, length=5]},<->, name intersections={of=4 and 1, name=41}] (1)
-- node[left] {$\Delta P$} (41-1) coordinate (4');

\path[name path=2] (2) -- ++(0, -5);
\path[name path=43] (4) -- (3);
\draw[dashed, plotblue, name intersections={of=2 and 43, name=23}] (2) -- (23-1) coordinate (3');

\draw[gray] (2) -- ++(0,2);
\draw[gray] (1) -- ++(0,1);

\draw[<->] (1) -- node[above] {$\Delta V$} ($(2) + (0,1)$);



  \path[]
     (1) node[circle, fill, inner sep=1.5pt] {} node[above left] {$1$}
     (2) node[circle, fill, inner sep=1.5pt] {} node[above right]  {$2$}
     (3) node[circle, fill, inner sep=1.5pt] {} node[below]  {$3$}
     (4) node[circle, fill, inner sep=1.5pt] {} node[below] {$4$}
     (4') node[circle, fill, inner sep=1.5pt] {} node[below] {$4'$}
     (3') node[circle, fill, inner sep=1.5pt] {} node[below] {$3'$};

