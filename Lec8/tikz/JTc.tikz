\begin{tikzpicture}
\begin{axis}[
  width=\linewidth,
  height=0.6\linewidth,
  title={Температурна залежність коефіцієнту Джоуля-Томсона},
  xlabel={Температура $T$ (K)},
  ylabel={$\mu$ (K/бар)},
  grid=both, xmin=0, xmax=1000, ymin=-0.15, ymax=0.5,
  legend pos=north east,
  ytick distance=0.1,
  mark=none,
  thick,
    xticklabel style={
        /pgf/number format/1000 sep={} % прибирає роздільник тисяч
    }
]
\pgfmathsetmacro{\R}{0.08314} % L bar / mol K

% N2
\pgfmathsetmacro{\aN}{1.352}
\pgfmathsetmacro{\bN}{0.0387}
\pgfmathsetmacro{\CpN}{0.29}
\addplot+[domain=80:1000, samples=300, gray, mark=none, ultra thick]
  {(2*\aN/(\R*x)-\bN)/\CpN};
\addlegendentry{N$_2$}

% Ar
\pgfmathsetmacro{\aA}{1.355}
\pgfmathsetmacro{\bA}{0.0320}
\pgfmathsetmacro{\CpA}{0.208}
\addplot+[domain=80:1000, samples=300, red, mark=none, ultra thick]
  {(2*\aA/(\R*x)-\bA)/\CpA};
\addlegendentry{Ar}

% CO2
\pgfmathsetmacro{\aC}{3.592}
\pgfmathsetmacro{\bC}{0.04267}
\pgfmathsetmacro{\CpC}{0.37}
\addplot+[domain=200:1000, samples=300,  blue, mark=none, ultra thick]
  {(2*\aC/(\R*x)-\bC)/\CpC};
\addlegendentry{CO$_2$}

% H2
\pgfmathsetmacro{\aH}{0.244}
\pgfmathsetmacro{\bH}{0.0266}
\pgfmathsetmacro{\CpH}{0.285}
\addplot+[domain=20:1000, samples=300, cyan, mark=none, ultra thick]
  {(2*\aH/(\R*x)-\bH)/\CpH};
\addlegendentry{H$_2$}

% He
\pgfmathsetmacro{\aHe}{0.0341}
\pgfmathsetmacro{\bHe}{0.0237}
\pgfmathsetmacro{\CpHe}{0.208}
\addplot+[domain=5:1000, samples=500, green!50!black, mark=none, ultra thick]
  {(2*\aHe/(\R*x)-\bHe)/\CpHe};
\addlegendentry{He}

\end{axis}
\end{tikzpicture}