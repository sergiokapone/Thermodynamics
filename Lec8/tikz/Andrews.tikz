
\begin{tikzpicture}[scale=1.75]
  \message{PV diagram - Maxwell construction^^J}
  \def\xmax{4}
  \def\ymax{3}
  \def\N{110}
  \def\s{0.6}
  \def\A{1.8}
  \def\isotherm#1#2{{ \A*(8*#2)/(3*#1-1) - 3*\A/(#1*#1) }} % reduced equation of state
  \coordinate (C) at (\s,\A);

  % LINE
  \foreach \i/\T/\pe in {0/.75/.28,1/.8/.39,2/.85/.5,3/.9/.65,4/.95/.82,5/1.0/1,6/1.1/1}{

    \begin{scope}
      \clip (-0.15*\xmax,0) rectangle (1.10*\xmax,\ymax);
      \ifthenelse{\i = 5}{
        \draw[plotred,variable=\x,domain=0.36:{.96*\xmax/\s},range=0:1,samples=\N,smooth,name path=isotherm]
          plot (\s*\x,\isotherm{\x}{\T}) node[plotred,right,scale=0.8] {$T_\text{c}$};
      }{
        \draw[plotblue,variable=\x,domain=0.36:{.96*\xmax/\s},range=0:1,samples=\N,smooth,name path=isotherm]
          plot (\s*\x,\isotherm{\x}{\T});
      }

      \ifthenelse{\i < 5}{ %\lengthtest{\pe pt < 1 pt}
        \path[name path={pe}] (0,\A*\pe) --++ ({.96*\xmax/\s},0);
        \path[name intersections={of=isotherm and pe,name=pe\i}];
      }

    \end{scope}
  }

  \begin{scope}
    \clip (0,0) rectangle (.96*\xmax,.96*\ymax);
    \fill[top color=plotblue!10,bottom color=plotred!10,middle color=plotred!10,shading angle=110,
          draw=plotblue!40,thin,use Hobby shortcut]
      (.06*\xmax,0) -- (pe0-1) -- (pe1-1) -- (pe2-1) -- (pe3-1) --
      (pe4-1) to[out=80,in=180]
      (C) to[out=0,in=135]
      (pe4-3) to[out=-42,in=145]
      (pe3-3) to[out=-35,in=155]
      (pe2-3) to[out=-25,in=165]
      (pe1-3) to[out=-15,in=170]
      (pe0-3) to[out=-10,in=172]
      (.97*\xmax,.144*\ymax) |- (0,0);
    \draw[plotred!40,thin,use Hobby shortcut]
      (C) to[out=0,in=135]
      (pe4-3) to[out=-42,in=145]
      (pe3-3) to[out=-35,in=155]
      (pe2-3) to[out=-25,in=165]
      (pe1-3) to[out=-15,in=170]
      (pe0-3) to[out=-10,in=172]
      (.97*\xmax,.144*\ymax) |- (0,0);
  \end{scope}
  \node[blue!40!black!90,below right] at (pe0-1) {\strut рідина};
  \node[red!40!black!90,below] at (pe0-3) {\strut газ};

  % MAXWELL CONSTRUCTION
  \fill (C) circle (1pt);
  \foreach \i in {0,1,2,3,4}{
    \draw[thin,plotblue] (pe\i-1) -- (pe\i-3);
    \fill[black] (pe\i-3) circle (.8pt);
    \fill[black] (pe\i-1) circle (.8pt);
  }

  % AXIS
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax)
    node[anchor=east,inner sep=4] {$P$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north,inner sep=4] {$V$};

\end{tikzpicture}