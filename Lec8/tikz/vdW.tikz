\begin{tikzpicture}[
    point/.style ={circle, draw, blue, fill=red, minimum size=4pt, inner sep=0pt},
declare function={
        isotherm(\x,\t)=(8*\t)/(3*\x-1)-3/(\x^2);
        Ppi(\x) = \x^2 * (3 - 2*\x);
    },
]
\begin{axis}[
    xlabel={$\phi$},
    ylabel={$\pi$},
    grid=both,
    samples=200,
    no markers,
    legend pos=north east,
    legend style={font=\small},
    width=12cm,
    height=8cm,
    domain=0.4:5,
    xmin=0, xmax=5,
    ymin=0, ymax=1.5,
    ytick distance = 0.5,
%    xmode=log,
    log ticks with fixed point,
    extra y tick style={
        tick label style={gray},
        major tick length=3pt,
        tick style={gray}
    },
]


\foreach[count=\n] \t in {0.65, 0.7,...,1.2} {
    \addplot[blue, thick, smooth] {isotherm(x,\t)} ;
}


\addplot[only marks] table[x=vg, y=p] {
t vg vl p
0.65 0.27965 0.37823 0.28648
0.70 0.46275 0.70236 0.14826
0.75 0.75064 1.36421 0.07241
0.80 1.37918 3.50226 0.03123
};
\end{axis}


\end{tikzpicture}