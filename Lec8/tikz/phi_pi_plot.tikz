\begin{tikzpicture}[
declare function={
        isotherm(\x,\t)=(8*\t)/(3*\x-1)-3/(\x^2);
    },
]
\begin{axis}[
    xlabel={$\phi$},
    ylabel={$\pi$},
    title={Изотермы ван дер Ваальса в приведённых единицах},
    grid=both,
    samples=200,
    no markers,
    legend pos=north east,
    legend style={font=\small},
    width=12cm,
    height=8cm,
%    axis lines=middle,
    xmin=0.1, xmax=10,
    ymin=0, ymax=1.5,
    ytick distance = 0.5,
    xmode=log,
    log ticks with fixed point, % Заставляет метки отображаться как числа
]
\foreach \t in {0.65, 0.7,...,1.2} {
    \addplot [blue, thick, smooth, domain=0.4:10] {isotherm(x,\t)} ;
}

\addplot[red, thick, domain=0.1:10] {1};
\node[circle, draw, blue, fill=red, minimum size=4pt, inner sep=0pt] at (1,1) {};
\end{axis}
\end{tikzpicture}