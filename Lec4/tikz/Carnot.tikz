% PV diagram - Carnot cycle

\tikzset{
  midarr/.style={decoration={markings,mark=at position #1 with
  {\arrow{stealth}}},postaction={decorate}},
  midarr/.default=0.5
}

\begin{tikzpicture}

  \def\N{40} % number of plot samples
  \def\xmax{5}
  \def\ymax{5}
  \def\xtick#1#2{\draw[thick] (#1)++(0,.1) --++ (0,-.2) node[below=-.5pt,scale=0.9] {#2};}
  \def\ytick#1#2{\draw[thick] (#1)++(.1,0) --++ (-.2,0) node[left=-.5pt,scale=0.9] {#2};}
  \def\Th{4}
  \def\Tc{1.5}
  \def\Ch{2}
  \def\Cc{50}
  \def\N{40}
  \def\gam{4.0}
  \def\isotherm#1#2{{ #2/(#1) }}
  \def\adiabatic#1#2{{ #2/(#1)^(\gam) }}
  \def\xA{ (\Th/\Ch)^(1/(1-\gam)) }
  \def\xB{ (\Th/\Cc)^(1/(1-\gam)) }
  \def\xC{ (\Tc/\Cc)^(1/(1-\gam)) }
  \def\xD{ (\Tc/\Ch)^(1/(1-\gam)) }
  \coordinate (A) at ({\xA},{\isotherm{\xA}{\Th}});
  \coordinate (B) at ({\xB},{\isotherm{\xB}{\Th}});
  \coordinate (C) at ({\xC},{\isotherm{\xC}{\Tc}});
  \coordinate (D) at ({\xD},{\isotherm{\xD}{\Tc}});

  %\clip (-0.1*\xmax,-0.12*\ymax) rectangle (1.05*\xmax,1.1*\ymax);


  % WORK
  \fill[blue!20,samples=\N]
    plot[domain={\xA:\xB}] (\x,\isotherm{\x}{\Th}) --
    plot[domain={\xB:\xC}] (\x,\adiabatic{\x}{\Cc}) --
    plot[domain={\xC:\xD}] (\x,\isotherm{\x}{\Tc}) --
    plot[domain={\xD:\xA}] (\x,\adiabatic{\x}{\Ch});
% \node[blue,scale=.9] at ($(B)!.5!(D)$) {$A$};

  % ADIABATIC & ISOTHERMIC TRANSFORMATIONS
  \draw[red!80!black,ultra thick,midarr=.60,domain={\xA:\xB},samples=\N]
    plot (\x,\isotherm{\x}{\Th}); % hot

  \draw[blue,ultra thick,midarr=.45,domain={\xB:\xC},samples=\N]
    plot (\x,\adiabatic{\x}{\Cc}); % cold

  \draw[red!80!black,ultra thick,midarr=.65,domain={\xC:\xD},samples=\N]
    plot (\x,\isotherm{\x}{\Tc}); % cold


  \draw[blue,ultra thick,midarr=.40,domain={\xD:\xA},samples=\N,
%        postaction={decorate,decoration={raise=1ex, text along path,text
%        align=center, text={Адіабата}}}
]
    plot(\x,\adiabatic{\x}{\Ch}); % hot

  % POINTS

     \path
     (A) node[inner sep=2pt, circle, fill] {} node[above] {$A$}
     (B) node[inner sep=2pt, circle, fill] {} node[above] {$B$}
     (C) node[inner sep=2pt, circle, fill] {} node[right] {$C$}
     (D) node[inner sep=2pt, circle, fill] {} node[left] {$D$};

    \pgfmathsetmacro\xH{0.4*(\xA + \xB)}
  % HEAT
   \draw[>={LaTeX[width=20,length=15, open]},<-,line width=5,red!60!black]
    ({\xH},\isotherm{\xH}{\Th}) -- ++(45:1.5) node[pos=1, above]
    {$Q_{H}$};

    \pgfmathsetmacro\xC{0.4*(\xC + \xD)}

   \draw[>={LaTeX[width=20,length=15,open]},->,line width=5,blue!60!black]
    ({\xC},\isotherm{\xC}{\Tc}) -- ++(45:-1) node[pos=1, below]
    {$Q_{L}$};

  % AXIS

%  \draw[gray!50] (0,0) grid (\xmax,\ymax);
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax+1)
    node[anchor=north east,inner sep=4] {$P$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north east,inner sep=4] {$V$};


\end{tikzpicture}
\quad
\begin{tikzpicture}
  \def\xmax{5}
  \def\ymax{5}

\coordinate (A) at (1, 4);
\coordinate (B) at (4, 4);
\coordinate (C) at (4, 1.5);
\coordinate (D) at (1, 1.5);
\coordinate (F) at (1, 0);
\coordinate (E) at (4, 0);


\fill[plotlightblue] (A) -- (B) -- (C) -- (D) --cycle;

\draw[ultra thick, midarr, plotred] (A) -- coordinate[pos=0.5] (QH) (B);
\draw[ultra thick, midarr, plotblue] (B) -- (C);
\draw[ultra thick, midarr, plotred] (C) -- coordinate[pos=0.5] (QL) (D);
\draw[ultra thick, midarr, plotblue] (D) -- (A);

   \draw[>={LaTeX[width=20,length=15, open]},<-,line width=5,red!60!black]
    (QH) --  ++(45:1.5) node[pos=1, above]
    {$Q_{H}$};

   \draw[>={LaTeX[width=20,length=15,open]},->,line width=5,blue!60!black]
    (QL) --  ++(45:-1) node[pos=1, below]
    {$Q_{L}$};


 \path
 (A) node[inner sep=2pt, circle, fill] {} node[left] {$A$}
 (B) node[inner sep=2pt, circle, fill] {} node[right] {$B$}
 (C) node[inner sep=2pt, circle, fill] {} node[right] {$C$}
 (D) node[inner sep=2pt, circle, fill] {} node[left] {$D$}
 (F) node[] {} node[below] {$F$}
 (E) node[] {} node[below] {$E$}
;

\draw[dashed] (D) -- (F);
\draw[dashed] (C) -- (E);


  % AXIS

%  \draw[gray!50] (0,0) grid (\xmax,\ymax);
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax+1)
    node[anchor=north east,inner sep=4] {$T$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north east,inner sep=4] {$S$};


\end{tikzpicture}

