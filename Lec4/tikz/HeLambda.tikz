\begin{tikzpicture}[scale=1.5,
% every node/.style={font=\scriptsize}
]

\def\xmax{5.2}
\def\ymax{6}
\def\ystep{1.5}

\draw[ultra thin, gray!30, step={(1, \ystep)}] (0,0) grid (\xmax,\ymax);
\coordinate (C) at (\xmax, {0.4*\ystep});
\coordinate (G) at (2.2, 0);
\coordinate (SolidStart) at (0, {2.5*\ystep});
\coordinate (SolidEnd) at (2,{4.0*\ystep});



% Фазовые линии
\draw[name path=S] (SolidStart) to[out=0, in=265] (SolidEnd);

\draw[name path=G] (G) to[bend right=10] (C);


\path[name path=L] (G) -- (1, {4*\ystep});
\draw[name path=Lline, name intersections={of=L and S, by=Lambda}] (G) -- (Lambda) ;


\path[thick,
intersection segments={of=S and L, sequence=L1--R1},
name path=SL
];
\path[name path=lb] (0,0) -- (G);
\tikzfillbetween[of=lb and SL]{blue, opacity=0.5};

\path[thick,
intersection segments={of=S and L, sequence=R1--L2},
name path=SL2
];

\path[name path=rb] (G) to[bend right=10] (C) -- (\xmax, \ymax) -- (SolidEnd);

\tikzfillbetween[of=rb and SL2]{orange, opacity=0.5};

\fill[plotlightblue, opacity=0.5] (G) to[bend right=10] (C) -- (\xmax, 0) -- cycle;
\fill[violet, opacity=0.5] (SolidStart) to[out=0, in=265] (SolidEnd) -- ++(-2, 0) -- cycle;



% Оси
\path (0,0) -- (\xmax,0) node[right] {$T$ (K)};
\path (0,0) -- (0,\ymax) node[above] {$P$ (atm)};
\draw[thick] (0,0) rectangle (\xmax,\ymax);

% Деления на осях
\foreach \x in {0, 1, 2, 3, 4, 5}
  \draw[thick] (\x,0) node[below] {\x} -- ++(0,0.1) ;

\foreach[evaluate=\y as \label using \y*10] \y in {0, 1, 2, 3}
  \draw[thick] (0,\y*\ystep)  node[left] {\pgfmathprintnumber[fixed]\label} -- ++(0.1,0);


% Підписи
\node[circle, draw, inner sep=1pt, fill=white] (CP) at (C) {};
\node at (1, \ystep) {He II};
\node at (3.5, {3*\ystep}) {He I};
\node[align=center] at (1, {3.5*\ystep}) {Твердий\\ He};
\node[text width=1.75cm] (Ctext) at (4, {1.5*\ystep}) {Критична точка};
\draw[-latex] (Ctext) -- (CP);
\coordinate (GAS) at (4.5, {0.1*\ystep}) {};
\node[align=center, inner sep=1pt] (GAStext) at (3, {0.5*\ystep}) {Газоподібний\\ He};
\draw[-latex] (GAStext.east) to[out=0, in=90] (GAS);

\path (G) -- node[sloped, above] {$\lambda$-лінія} (Lambda);


\end{tikzpicture}
