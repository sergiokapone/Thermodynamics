% Rankin
\begin{tikzpicture}[
  midarr/.style={decoration={markings,mark=at position #1 with
  {\arrow{stealth}}},postaction={decorate}},
  midarr/.default=0.5
]

  \def\xmax{8}
  \def\ymax{5}

  \coordinate (2) at (1, 5);
  \coordinate (2') at (1.5, 5);
  \coordinate (3) at (4, 5);
  \coordinate (4) at (6, 1);
  \coordinate (4') at (4, 1);
  \coordinate (1) at (1, 1);
  \coordinate (1') at (1.5, 1);


  % WORK

    \fill[plotlightblue] (1) -- (2) -- (3) to[bend right] (4) --cycle;

    \draw[plotblue,ultra thick,midarr=.5] (2) --  (3);
    \draw[plotred,ultra thick,midarr=.5] (3) to[bend right]  (4);


    \path[midarr=.5,
      postaction={decorate},
      decoration={text along path,
                  raise=1ex,
                  text={|\scriptsize|Ізоентропійне розширення},
                  text align={center}
                },
                ] (3) to[bend right]  (4);


    \draw[dashed, plotred, ultra thick,midarr=.5] (4')
    to[bend left]  (1, 4);
    \draw[plotblue,ultra thick,midarr=.5] (4) -- (1);
    \draw[plotblue,ultra thick,midarr=.5] (1) -- (2);
    \draw[dashed,ultra thick, blue] (1') -- (2');

 \path
    (1) node[circle, inner sep=1.5pt, fill] {} node[below] {$1$}
    (1') node[circle, inner sep=1.5, fill] {} node[below] {$1'$}
    (2') node[circle, inner sep=1.5, fill] {} node[above] {$2'$}
    (2) node[circle, inner sep=1.5, fill] {} node[above] {$2$}
    (3) node[circle, inner sep=1.5, fill] {} node[above] {$3$}
    (4) node[circle, inner sep=1.5, fill] {} node[below] {$4$}
    (4') node[circle, inner sep=1.5, fill] {} node[below] {$4'$}
    ;


  % AXIS
\begin{scope}
%  \draw[gray!50] (0,0) grid (\xmax,\ymax);
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax+1)
    node[anchor=north east,inner sep=4] {$P$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north east,inner sep=4] {$V$};

