% Rankin
\begin{tikzpicture}[
  midarr/.style={decoration={markings,mark=at position #1 with
  {\arrow{stealth}}},postaction={decorate}},
  midarr/.default=0.5
]

  \def\xmax{8}
  \def\ymax{5}

  \coordinate (b) at (2, 4);
  \coordinate (a) at (6, 4);
  \coordinate (d) at (5, 2);
  \coordinate (c) at (2, 2);

\fill[plotlightblue] (0.5,0) to[bend left=10] (b) to[out=55, in=70, looseness=3] (d) to[out=255,
in=95] (4.8, 0) --
cycle;

\draw [plotblue, thick, midarr=0.75] (a) -- (b);
\draw [plotblue, thick, midarr] (b) -- (c);
\draw [plotblue, thick, midarr] (c) -- (d);
\draw [plotblue, thick, midarr] (d) -- (a);

  % WORK


 \path
    (c) node[circle, inner sep=1.5pt, fill] {} node[below] {$c$}
    (b) node[circle, inner sep=1.5, fill] {} node[above] {$b$}
    (a) node[circle, inner sep=1.5, fill] {} node[above] {$a$}
    (d) node[circle, inner sep=1.5, fill] {} node[below] {$d$}
    ;

\draw (0.5,0) to[bend left=10] (b) to[out=55, in=70, looseness=3] (d) to[out=255, in=95] (4.8, 0) --
cycle;



   \draw[>={LaTeX[width=20,length=15, open]},<-,line width=5,plotblue]  ($(c)!0.5!(d)$) -- ++(0,-1)
   node[pos=1, below]  {$Q1$};

   \draw[>={LaTeX[width=20,length=15, open]},->,line width=5,plotred]  ($(b)!0.5!(a)$) -- ++(0,+1)
   node[pos=1, above]  {$Q_2$};

   \draw[>={LaTeX[width=20,length=15, open]},<-,line width=5]  ($(a)!0.5!(d)$) -- ++(+2,0)
   node[pos=1, right]  {$A$};



  % AXIS
\begin{scope}
%  \draw[gray!50] (0,0) grid (\xmax,\ymax);
  \draw[->,thick] (0,-0.1*\ymax) -- (0,\ymax+1)
    node[anchor=north east,inner sep=4] {$P$};
  \draw[->,thick] (-0.1*\xmax,0) -- (\xmax,0)
    node[anchor=north east,inner sep=4] {$h$};

\end{scope}




