\begin{tikzpicture}[]
%    \draw (-2.5, -1) grid  ++(5,2);
    \def\L{10}
    \def\P{1}
    \coordinate (A) at (-2.5, +1);
    \coordinate (A') at ({-2.5 + \L}, +1);
    \coordinate (B) at (-2.5, -1);
    \coordinate (B') at ({-2.5 + \L}, -1);

    \draw[thick, plotblue, pattern=north west lines, pattern color=plotblue] (A) rectangle ++(\L,
    0.2);


    \node[below left] at (\P, +1) {$c$};
    \node[above left] at (\P, -1) {$d$};

    \node[below left] at ({\P-2}, +1) {$a$};
    \node[above left] at ({\P-2}, -1) {$b$};

    \draw[thick, gray!100, pattern=porous, pattern color=gray!70]  (\P, -1) rectangle ++(1, 2);

    \draw[bottom color=gray, top color=gray!20] ({\P+1},-1) rectangle ++(0.25,2);
    \draw[left color=gray, right color=gray!20] ({\P+1.25},-0.1) rectangle ++(5.5,0.2);

    \draw[bottom color=gray, top color=gray!20] ({\P-2.5},-1) rectangle ++(-0.25,2);
    \draw[right color=gray, left color=gray!20] ({\P-2.75},-0.1) rectangle ++(-1.5,0.2);

    \draw[thick, plotblue, pattern=north east lines, pattern color=plotblue] (B) rectangle
    ++(10, -0.2);

    \draw[black, >={LaTeX[width=20,length=15,open]}, ->, line width=5pt] (-3.75, -0.5) -- ++ (2, 0);
    \draw[black, >={LaTeX[width=20,length=15,open]}, ->, line width=5pt] (2.25, -0.5) -- ++ (2, 0);

    \draw[plotblue, thick]  (A) to[out=275, in=45]   (B);
    \draw[plotblue, thick]  (A') to[out=275, in=135] (B');

    \node[align=left, text width=1cm, text=plotblue] at (-0.4, 0) {$P_1$ $V_1$ $T_1$};
%    \node[align=left, text width=1cm] at (1, 0) {$P_2$ \\ $V_2$ \\ $T_2$};

\begin{scope}[yshift=-3cm]
    \coordinate (A) at (-2.5, +1);
    \coordinate (A') at ({-2.5 + \L}, +1);
    \coordinate (B) at (-2.5, -1);
    \coordinate (B') at ({-2.5 + \L}, -1);

    \node[below right] at ({\P + 1}, +1) {$a'$};
    \node[above right] at ({\P + 1}, -1) {$b'$};

    \node[below left] at ({\P+5}, +1) {$c'$};
    \node[above left] at ({\P+5}, -1) {$d'$};


    \draw[thick, plotblue, pattern=north west lines, pattern color=plotblue] (A) rectangle ++(\L,
    0.2);

    \draw[thick, gray!100, pattern=porous, pattern color=gray!70]  (\P, -1) rectangle ++(1, 2);

    \draw[bottom color=gray, top color=gray!20] ({\P+5},-1) rectangle ++(0.25,2);
    \draw[left color=gray, right color=gray!20] ({\P+5.25},-0.1) rectangle ++(4.5,0.2);

    \draw[bottom color=gray, top color=gray!20] ({\P},-1) rectangle ++(-0.25,2);
    \draw[right color=gray, left color=gray!20] ({\P-0.25},-0.1) rectangle ++(-3.5,0.2);

    \draw[thick, plotblue, pattern=north east lines, pattern color=plotblue] (B) rectangle
    ++(10, -0.2);

    \draw[black, >={LaTeX[width=20,length=15,open]}, ->, line width=5pt] (-1.25, -0.5) -- ++ (2, 0);
    \draw[black, >={LaTeX[width=20,length=15,open]}, ->, line width=5pt] (6.25, -0.5) -- ++ (2, 0);

    \draw[plotblue, thick]  (A) to[out=275, in=45]   (B);
    \draw[plotblue, thick]  (A') to[out=275, in=135] (B');

%    \node[align=left, text width=1cm] at (-1, 0) {$P_1$ \\ $V_1$ \\ $T_1$};
    \node[align=left, text width=1cm, text=plotblue] at (4, 0) {$P_2$ \\ $V_2$ \\ $T_2$};
\end{scope}

\end{tikzpicture}